{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "new_location": "inherit",
    "permissions": "prompt",
    "grouping": "auto",
    "verbosity": "medium",
    "image_preview": true
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word",
    "tree": true,
    "single": false
  },
  "prompt": {
    "paste": "compact"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.7999999999999999
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "highlights": true,
  "debug": {
    "devtools": false
  }
}
